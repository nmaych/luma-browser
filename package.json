{
  "name": "luma-browser",
  "productName": "Luma Browser",
  "version": "1.13.0",
  "private": true,
  "description": "A lightweight standalone Electron web browser with real tabbed browsing.",
  "author": "Luma Browser",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -s first \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http-get://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/run-electron.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "start": "node scripts/run-electron.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dist": "npm run build && node scripts/package.mjs",
    "dist:dir": "npm run build && node scripts/package.mjs --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:electron": "playwright test --config=playwright.electron.config.ts",
    "test:packaged": "node scripts/verify-packaged.mjs",
    "typecheck": "tsc -b --pretty false",
    "clean:release": "node scripts/cleanRelease.mjs",
    "verify:pageviews": "node scripts/verify-pageviews.mjs"
  },
  "build": {
    "appId": "com.luma.browser",
    "productName": "Luma Browser",
    "copyright": "Copyright © 2026 Luma Browser",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Luma-Browser-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Luma Browser"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nmaych",
        "repo": "luma-browser"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "jsdom": "^25.0.1",
    "png-to-ico": "^3.0.2",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
